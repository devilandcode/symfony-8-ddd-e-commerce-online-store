{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form with ['@EasyAdmin/crud/form_theme.html.twig'] only %}

{% block content_title %}{{ title }}{% endblock %}

{% block main %}
    {{ form_start(form) }}
        {% if currentImage is not empty %}
            <p>Current image:</p>
            <img src="{{ asset(currentImage) }}" alt="" style="max-width: 240px; max-height: 120px;">
        {% endif %}
        {{ form_widget(form) }}
        <button class="btn btn-primary" type="submit">Save</button>
        <a class="btn btn-secondary" href="{{ path('admin_brands_index') }}">Cancel</a>
    {{ form_end(form) }}
{% endblock %}
