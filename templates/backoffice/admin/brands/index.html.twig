{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Brands{% endblock %}

{% block main %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('danger') %}
        <div class="alert alert-danger" role="alert">{{ message }}</div>
    {% endfor %}

    <div class="mb-3">
        <a class="btn btn-primary" href="{{ path('admin_brands_new') }}">Create brand</a>
    </div>

    <table class="table datagrid">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Slug</th>
                <th scope="col">Position</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for brand in brands %}
                <tr>
                    <td>{{ brand.title }}</td>
                    <td>{{ brand.slug }}</td>
                    <td>{{ brand.position }}</td>
                    <td>{{ brand.isActive ? 'Active' : 'Inactive' }}</td>
                    <td class="text-nowrap">
                        <a class="btn btn-secondary btn-sm" href="{{ path('admin_brands_edit', {id: brand.id}) }}">Edit</a>
                        <form class="d-inline" method="post" action="{{ path('admin_brands_delete', {id: brand.id}) }}" onsubmit="return confirm('Delete this brand?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-brand-' ~ brand.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No brands found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
