{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Characteristics{% endblock %}

{% block main %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    <div class="mb-3">
        <a class="btn btn-primary" href="{{ path('admin_characteristics_new') }}">Create characteristic</a>
    </div>

    <table class="table datagrid">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Measure</th>
                <th scope="col">Position</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for characteristic in characteristics %}
                <tr>
                    <td>{{ characteristic.title }}</td>
                    <td>{{ characteristic.measure ?? '—' }}</td>
                    <td>{{ characteristic.position }}</td>
                    <td>{{ characteristic.isActive ? 'Active' : 'Inactive' }}</td>
                    <td class="text-nowrap">
                        <a class="btn btn-secondary btn-sm" href="{{ path('admin_characteristics_edit', {id: characteristic.id}) }}">Edit</a>
                        <form class="d-inline" method="post" action="{{ path('admin_characteristics_delete', {id: characteristic.id}) }}" onsubmit="return confirm('Delete this characteristic?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-characteristic-' ~ characteristic.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No characteristics found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
