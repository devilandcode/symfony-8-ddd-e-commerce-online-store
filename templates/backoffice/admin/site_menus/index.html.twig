{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Site menus{% endblock %}

{% block main %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    <div class="mb-3">
        <a class="btn btn-primary" href="{{ path('admin_site_menus_new') }}">Create site menu</a>
    </div>

    <table class="table datagrid">
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Slug</th>
                <th scope="col">Is header</th>
                <th scope="col">Is footer</th>
                <th scope="col">Position</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for menu in site_menus %}
                <tr>
                    <td>{{ menu.title }}</td>
                    <td>{{ menu.slug }}</td>
                    <td>{{ menu.header ? 'Yes' : 'No' }}</td>
                    <td>{{ menu.footer ? 'Yes' : 'No' }}</td>
                    <td>{{ menu.position}}</td>
                    <td>{{ menu.isActive ? 'Active' : 'Inactive' }}</td>


                    {# <td class="text-nowrap">
                        <a class="btn btn-secondary btn-sm" href="{{ path('admin_site_menus_edit', {id: page.id}) }}">Edit</a>
                        <form class="d-inline" method="post" action="{{ path('admin_site_menus_delete', {id: page.id}) }}" onsubmit="return confirm('Delete this site menu?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-site-menu-' ~ page.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                        </form>
                    </td> #}
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No site menu found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
