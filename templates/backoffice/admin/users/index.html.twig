{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Users{% endblock %}

{% block main %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success" role="status">{{ message }}</div>
    {% endfor %}

    <div class="mb-3">
        <a class="btn btn-primary" href="{{ path('admin_users_new') }}">Create user</a>
    </div>

    <table class="table datagrid">
        <thead>
            <tr>
                <th scope="col">Name</th>
                <th scope="col">Email</th>
                <th scope="col">Role</th>
                <th scope="col">Status</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
                <tr>
                    <td>{{ user.name }} {{ user.surname }}</td>
                    <td>{{ user.email }}</td>
                    <td>{{ user.role.value|capitalize }}</td>
                    <td>{{ user.status ? user.status.value|capitalize : '—' }}</td>
                    <td class="text-nowrap">
                        <a class="btn btn-secondary btn-sm" href="{{ path('admin_users_edit', {id: user.id}) }}">Edit</a>
                        <form class="d-inline" method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" onsubmit="return confirm('Delete this user?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                            <button class="btn btn-danger btn-sm" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">No users found.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
