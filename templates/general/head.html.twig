<head>
    <meta http-equiv="content-type" content="text/html" charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0,minimum-scale=1.0,maximum-scale=1.0,user-scalable=no">
    <meta name="format-detection" content="telephone=no" />
	<meta name="theme-color" content="#fff">
    <meta name="csrf-token" content="{{ csrf_token('app') }}">

{% if seo is defined %}
    <meta property="og:title" content="{{ seo.title }}"/>
    <meta property="og:description" content="{{ seo.description }}"/>    
    <meta property="og:type" content="article"/>
    <meta property="og:site_name" content="{{ app.request.server.get('APP_NAME')|default('HV-store') }}"/>
    <meta property="og:url" content="{{ app.request.uri }}" />

    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}"/>
    <meta name="title" content="{{ seo.title }}">
{% endif %}

{% if app.request.query.get('page') %}
    <link rel="canonical" href="{{ app.request.uri }}" />
{% endif %}

    <link rel="shortcut icon" href="{{ asset('assets/i/favicon.svg') }}" type="image/svg+xml"/>

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Infant:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Roboto+Flex:opsz,wght@8..144,100..1000&family=Tektur:wght@400..900&display=swap" rel="stylesheet">

{% if app.request.attributes.get('_route') == 'contacts' %}
	<script src="https://api-maps.yandex.ru/2.1/?apikey={% if metrics is defined and metrics.yandex_api %}{{ metrics.yandex_api }}{% endif %}&lang=ru-RU" type="text/javascript"></script>
{% endif %}

{% if app.request.attributes.get('_route') in ['one-news', 'one-article'] %}
    <script type="text/javascript" src="https://yastatic.net/share2/share.js"></script>
{% endif %}
    
	<script type="text/javascript" src="https://yastatic.net/es5-shims/0.0.2/es5-shims.min.js"></script>

{% if metrics is defined and metrics.head is not empty %}
    {{ metrics.head|raw }}
{% endif %}

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>


