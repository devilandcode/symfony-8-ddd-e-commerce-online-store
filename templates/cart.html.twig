{% extends 'layouts/main.html.twig' %}

{% set page = cartPage.page %}

{% block content %}
    {% set cart = cartPage.cart %}
    <section class="s-line s-breadcrumbs">
        <div class="container md-pt-20 md-pb-20 pt-5">
            <div class="w-breadcrumbs-mobile-scroll-shadow">
                {% include 'general/breadcrumbs.html.twig' with {page: cartPage.page} only %}
            </div>
            <div class="xl-pt-20 mb-20">
                <h1 class="pagetitle _h2 upper fontCor semibold color-dblue">{{ cartPage.page.h1 ?? cartPage.page.title }}</h1>
            </div>
        </div>
    </section>

    <section class="s-line">
        <div class="container xl-pb-60 pb-80">
            <div class="w-cart-empty xl-pt-40 pt-20{{ cart.isEmpty ? '' : ' hidden' }} _js-cart-empty">
                <div class="_h4 upper fontCor semibold color-dblue mb-20">Корзина пуста</div>
                <a href="{{ path('catalog') }}" class="button medium">ПЕРЕЙТИ В КАТАЛОГ</a>
            </div>
            {% if not cart.isEmpty %}
                <div class="w-cart-page _js-cart-page">
                    <div class="row row-cart-page">
                        <div class="col-xl-6 col-lg-7 col-md-8 col-12 pb-30">
                            <div class="w-cart-list xl-mb-40 mb-20">
                                {% for item in cart.items %}
                                <div class="w-cart-list-item _js-cart-item">
                                    <div class="row row-cart-list-item md-gutters">
                                        <div class="col-image col sm-pb-20 pb-10">
                                            <a href="" class="block__link image__link">
                                                {% if item.image is not empty %}
                                                    <img src="{{ asset(image_variant(item.image, 400, 400, 'contain')) }}" alt="{{ item.title }}" class="img block">
                                                {% endif %}
                                            </a>
                                        </div>
                                        <div class="col-content col sm-pb-20 pb-20">
                                            <div class="w-title xl-mb-10 mb-5">
                                                <div class="description xl-mb-10 mb-5">{{ item.brandTitle }}</div>
                                                <div class="name _h5 semibold upper">
                                                    <a href="" class="name__link block__link nul color-black"><span class="dashed dash">{{ item.title }}</span></a>
                                                </div>
                                            </div>
                                            <div class="row sm-gutters align-items-center">
                                                {% if item.discountPercent is not null %}
                                                    <div class="col-auto">
                                                        <div class="xl-mb-10 mb-5">
                                                            <div class="round-sticker-default color002">{{ item.discountPercent }}%</div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if item.volume is not empty %}
                                                    <div class="col-auto"><div class="xl-mb-10 mb-5">{{ item.volume }}</div></div>
                                                {% endif %}
                                                {% if item.color is not empty %}
                                                    <div class="col-auto"><div class="xl-mb-10 mb-5">Цвет: <span class="color-gray">{{ item.color }}</span></div></div>
                                                {% endif %}
                                            </div>
                                            <div class="row justify-content-between align-items-end sm-gutters">
                                                <div class="col-auto xl-mt-10 mt-5">
                                                    <div class="pcscontrolls _js-pcscontrolls">
                                                        <a class="btn fcm left minus _js-b-minus{{ item.quantity > 1 ? '' : ' disabled' }}" role="button" aria-label="Уменьшить количество">
                                                            <svg width="20" height="20" viewBox="0 0 34 5" xmlns="http://www.w3.org/2000/svg"><path d="M0.333496 2.75008C0.333496 2.19755 0.55299 1.66764 0.943691 1.27694C1.33439 0.886241 1.8643 0.666748 2.41683 0.666748H31.5835C32.136 0.666748 32.6659 0.886241 33.0566 1.27694C33.4473 1.66764 33.6668 2.19755 33.6668 2.75008C33.6668 3.30262 33.4473 3.83252 33.0566 4.22322C32.6659 4.61392 32.136 4.83341 31.5835 4.83341H2.41683C1.8643 4.83341 1.33439 4.61392 0.943691 4.22322C0.55299 3.83252 0.333496 3.30262 0.333496 2.75008Z"></path></svg>
                                                        </a>
                                                        <input type="text" value="{{ item.quantity }}" class="input__default" data-product-id="{{ item.productId }}" data-count="{{ item.quantity }}" data-max="{{ item.availableUnits }}" readonly>
                                                        <a class="btn fcm right plus _js-b-plus{{ item.canIncreaseQuantity ? '' : ' disabled' }}" role="button" aria-label="Увеличить количество">
                                                            <svg width="20" height="20" viewBox="0 0 34 34" xmlns="http://www.w3.org/2000/svg"><path d="M0 17.0833C0 16.5308 0.219494 16.0009 0.610195 15.6102C1.0009 15.2195 1.5308 15 2.08333 15H31.25C31.8025 15 32.3324 15.2195 32.7231 15.6102C33.1138 16.0009 33.3333 16.5308 33.3333 17.0833C33.3333 17.6359 33.1138 18.1658 32.7231 18.5565C32.3324 18.9472 31.8025 19.1667 31.25 19.1667H2.08333C1.5308 19.1667 1.0009 18.9472 0.610195 18.5565C0.219494 18.1658 0 17.6359 0 17.0833Z"></path><path d="M17.0833 0C17.6359 0 18.1658 0.219493 18.5565 0.610194C18.9472 1.00089 19.1667 1.5308 19.1667 2.08333V31.25C19.1667 31.8025 18.9472 32.3324 18.5565 32.7231C18.1658 33.1138 17.6359 33.3333 17.0833 33.3333C16.5308 33.3333 16.0009 33.1138 15.6102 32.7231C15.2195 32.3324 15 31.8025 15 31.25V2.08333C15 1.5308 15.2195 1.00089 15.6102 0.610194C16.0009 0.219493 16.5308 0 17.0833 0Z"></path></svg>
                                                        </a>
                                                    </div>
                                                </div>
                                                <div class="col-xl-6 col-lg-5 col-md-6 col-6 xl-mt-10 mt-5">
                                                    <div class="align-right">
                                                        <div class="row justify-content-end align-items-end sm-gutters">
                                                            <div class="col-12 col">сумма</div>
                                                            {% if item.oldTotalMinorUnits is not null %}
                                                                <div class="col-12 col"><div class="_h6 static color-gray line-through old-price _js-cart-item-old-total">{{ item.oldTotalMinorUnits|money(item.currencyCode) }}</div></div>
                                                            {% endif %}
                                                            <div class="col-12 col"><div class="_h4 static bold color-dblue _js-cart-item-total">{{ item.totalMinorUnits|money(item.currencyCode) }}</div></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="w-delete">
                                        <a href="" class="delete__link _js-b-remove" title="Удалить из корзины">
                                            <svg width="15" height="16" viewBox="0 0 15 16" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14.0625 2.5H10.625V1.5625C10.625 1.1481 10.4604 0.750671 10.1674 0.457646C9.87433 0.16462 9.4769 0 9.0625 0H5.3125C4.8981 0 4.50067 0.16462 4.20765 0.457646C3.91462 0.750671 3.75 1.1481 3.75 1.5625V2.5H0.3125C0.22962 2.5 0.150134 2.53292 0.0915292 2.59153C0.0329241 2.65013 0 2.72962 0 2.8125C0 2.89538 0.0329241 2.97487 0.0915292 3.03347C0.150134 3.09208 0.22962 3.125 0.3125 3.125H1.25V14.6875C1.25 14.9361 1.34877 15.1746 1.52459 15.3504C1.7004 15.5262 1.93886 15.625 2.1875 15.625H12.1875C12.4361 15.625 12.6746 15.5262 12.8504 15.3504C13.0262 15.1746 13.125 14.9361 13.125 14.6875V3.125H14.0625C14.1454 3.125 14.2249 3.09208 14.2835 3.03347C14.3421 2.97487 14.375 2.89538 14.375 2.8125C14.375 2.72962 14.3421 2.65013 14.2835 2.59153C14.2249 2.53292 14.1454 2.5 14.0625 2.5ZM4.375 1.5625C4.375 1.31386 4.47377 1.0754 4.64959 0.899587C4.8254 0.723772 5.06386 0.625 5.3125 0.625H9.0625C9.31114 0.625 9.5496 0.723772 9.72541 0.899587C9.90123 1.0754 10 1.31386 10 1.5625V2.5H4.375V1.5625ZM12.5 14.6875C12.5 14.7704 12.4671 14.8499 12.4085 14.9085C12.3499 14.9671 12.2704 15 12.1875 15H2.1875C2.10462 15 2.02513 14.9671 1.96653 14.9085C1.90792 14.8499 1.875 14.7704 1.875 14.6875V3.125H12.5V14.6875ZM5.625 6.5625V11.5625C5.625 11.6454 5.59208 11.7249 5.53347 11.7835C5.47487 11.8421 5.39538 11.875 5.3125 11.875C5.22962 11.875 5.15013 11.8421 5.09153 11.7835C5.03292 11.7249 5 11.6454 5 11.5625V6.5625C5 6.47962 5.03292 6.40013 5.09153 6.34153C5.15013 6.28292 5.22962 6.25 5.3125 6.25C5.39538 6.25 5.47487 6.28292 5.53347 6.34153C5.59208 6.40013 5.625 6.47962 5.625 6.5625ZM9.375 6.5625V11.5625C9.375 11.6454 9.34208 11.7249 9.28347 11.7835C9.22487 11.8421 9.14538 11.875 9.0625 11.875C8.97962 11.875 8.90013 11.8421 8.84153 11.7835C8.78292 11.7249 8.75 11.6454 8.75 11.5625V6.5625C8.75 6.47962 8.78292 6.40013 8.84153 6.34153C8.90013 6.28292 8.97962 6.25 9.0625 6.25C9.14538 6.25 9.22487 6.28292 9.28347 6.34153C9.34208 6.40013 9.375 6.47962 9.375 6.5625Z"/></svg>
                                        </a>
                                    </div>
                                </div>
                                {% endfor %}
                            </div>

