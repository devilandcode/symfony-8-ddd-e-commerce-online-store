{% extends 'layouts/main.html.twig' %}

{% block content %}
    <section class="s-line s-breadcrumbs">
        <div class="container md-pt-20 md-pb-20 pt-5">
            <div class="w-breadcrumbs-mobile-scroll-shadow">
                {% include 'general/breadcrumbs.html.twig' with {page: {title: 'Корзина'}} only %}
            </div>
        </div>
    </section>

    <section class="s-line">
        <div class="container xl-pb-60 pb-80">
            {% if cart.isEmpty %}
            <div class="w-cart-empty xl-pt-40 pt-20">
                <div class="_h4 upper fontCor semibold color-dblue mb-20">Корзина пуста</div>
                <a href="{{ path('catalog') }}" class="button medium">ПЕРЕЙТИ В КАТАЛОГ</a>
            </div>
            {% else %}
            <div class="w-cart-page">
                <div class="row row-cart-page">
                    <div class="col-xl-6 col-lg-7 col-md-8 col-12 pb-30">
                        <div class="w-cart-list xl-mb-40 mb-20">
                            {% for item in cart.items %}
                            <div class="w-cart-list-item">
                                <div class="row row-cart-list-item md-gutters">
                                    <div class="col-image col sm-pb-20 pb-10">
                                        <a href="" class="block__link image__link">
                                            {% if item.image is not empty %}
                                                <img src="{{ asset(image_variant(item.image, 400, 400, 'contain')) }}" alt="{{ item.title }}" class="img block">
                                            {% endif %}
                                        </a>
                                    </div>
                                    <div class="col-content col sm-pb-20 pb-20">
                                        <div class="w-title xl-mb-10 mb-5">
                                            <div class="description xl-mb-10 mb-5">{{ item.brandTitle }}</div>
                                            <div class="name _h5 semibold upper">
                                                <a href="" class="name__link block__link nul color-black"><span class="dashed dash">{{ item.title }}</span></a>
                                            </div>
                                        </div>
                                        <div class="row justify-content-between align-items-end sm-gutters">
                                            <div class="col-auto xl-mt-10 mt-5">
                                                <div class="pcscontrolls">
                                                    <input type="text" value="{{ item.quantity }}" class="input__default" readonly>
                                                </div>
                                            </div>
                                            <div class="col-xl-6 col-lg-5 col-md-6 col-6 xl-mt-10 mt-5">
                                                <div class="align-right">
                                                    <div class="row justify-content-end align-items-end sm-gutters">
                                                        <div class="col-12 col">сумма</div>
                                                        {% if item.oldTotalMinorUnits is not null %}
                                                            <div class="col-12 col"><div class="_h6 static color-gray line-through old-price">{{ item.oldTotalMinorUnits|money(item.currencyCode) }}</div></div>
                                                        {% endif %}
                                                        <div class="col-12 col"><div class="_h4 static bold color-dblue">{{ item.totalMinorUnits|money(item.currencyCode) }}</div></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% endfor %}
                        </div>

                        <div class="xl-mb-40 mb-20">
                            <div class="s-name fontCor _h4 upper color-dblue mb-20">1 Личные данные</div>
                            <div class="row">
                                <div class="col-md-6 col-sm-6 col-12 mb-20">
                                    <div class="input mb-20 input-password _js-label-top-absolute label-top-absolute empty">
