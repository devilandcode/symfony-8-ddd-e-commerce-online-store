{% extends 'layouts/main.html.twig' %}

{% block content %}
    {% set pageContent = homePage.page.pageContent %}
    {% set sections = pageContent.sections|default({}) %}
    {% set newArrivals = sections.new_arrivals|default({}) %}
    {% set popularBrands = sections.popular_brands|default({}) %}
    {% set priceHits = sections.price_hits|default({}) %}
    {% set heroSlides = pageContent.slides|default([])|filter(slide => slide.isActive|default(false) and slide.desktopImage|default('') is not empty) %}

    {% if heroSlides is not empty %}
        <section class="s-line s-index-slider">
            <div class="owl-carousel owl-index-slider">
                {% for slide in heroSlides %}
                    <div class="slide mobile" style="background-image: url('{{ asset(image_variant(slide.mobileImage ?? slide.desktopImage, 750, 1125, 'cover')) }}');">
                        <div class="slide desktop" style="background-image: url('{{ asset(image_variant(slide.desktopImage, 1920, 600, 'cover')) }}');">
                            <div class="overlay"></div>
                            <div class="container">
                                <div class="row row-slide-content align-items-center">
                                    <div class="col-12 col">
                                        {% if slide.heading is not empty %}
                                            <div class="description _h3 mt-20">
                                                <div class="row">
                                                    <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">{{ slide.heading }}</div>
                                                </div>
                                            </div>
                                        {% endif %}
                                        {% if slide.description is not empty %}
                                            <div class="description _h6 mt-30">
                                                <div class="row">
                                                    <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">{{ slide.description }}</div>
                                                </div>
                                            </div>
                                        {% endif %}
                                        {% if slide.buttonLabel is not empty and slide.buttonUrl is not empty %}
                                            <div class="w-button mt-50">
                                                <div class="row justify-content-sm-start justify-content-center">
                                                    <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-5 col-sm-6 col-xs-8 col-9">
                                                        <a href="{{ slide.buttonUrl }}" class="button transparent white block">{{ slide.buttonLabel }}</a>
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="s-line s-items-slider">
        <div class="container pt-60 pb-60">
            <div class="_h2 upper fontCor semibold color-dblue align-center xl-mb-45 md-mb-30 mb-20">
                {{ newArrivals.heading|default('') }}
            </div>
            {% if homePage.catalog.newProducts is not empty %}
                <div class="owl-carousel owl-products-more-slider">
                    {% for product in homePage.catalog.newProducts %}
                        <div class="slide">
                            <div class="w-catalog-list-item-frame">
                                {% include 'catalog/preview.html.twig' with {product: product} only %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="row justify-content-center mt-40">
                <div class="col-sm-auto col-10">
                    {% if newArrivals.buttonLabel|default('') is not empty and newArrivals.buttonUrl|default('') is not empty %}
                        <a href="{{ newArrivals.buttonUrl }}" class="button transparent blue block">{{ newArrivals.buttonLabel }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

    <section class="s-line s-index-slider s-index-offer-image">
        <div class="slide mobile" style="background-image: url({{ asset('content/index-slide002-m.png') }});">
            <div class="slide desktop" style="background-image: url({{ asset('content/index-slide002-d.png') }});">
                <div class="overlay" style="background: linear-gradient(to top, rgba(0,0,0,0.0), rgba(0,0,0,0.0));"></div>
                <div class="container">
                    <div class="row row-slide-content align-items-center">
                        <div class="col-12 col">
                            <div class="image">
                                <div class="row">
                                    <div class="col-xl-4 col-lg-5 col-md-7 col-sm-9 col-12">
                                        <img src="{{ asset('content/index-slide-logo02.png') }}" alt="" class="img block">
                                    </div>
                                </div>
                            </div>
                            <div class="description _h6 mt-30">
                                <div class="row">
                                    <div class="col-xl-5 col-lg-6 col-md-8 col-sm-10 col-12">
                                        Estoy encantada con este serum. Tengo la piel más hidratada, tersa, suave y con una luz preciosa. Me gusta mucho su olor y textura. Es fluido, por lo que se necesita utilizar poco producto. Seguiré repitiendo con ella, muy recomendable.
                                    </div>
                                </div>
                            </div>
                            <div class="w-button mt-50">
                                <div class="row justify-content-sm-start  justify-content-center">
                                    <div class="col-xxl-2 col-xl-3 col-lg-4 col-md-5 col-sm-6 col-xs-8 col-9">
                                        <a href="" class="button dblue block">В каталог</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="s-line s-items-slider">
        <div class="container pt-60 pb-60">
            <div class="_h2 upper fontCor semibold color-dblue align-center xl-mb-45 md-mb-30 mb-20">
                {{ popularBrands.heading|default('') }}
            </div>
            {% if homePage.catalog.brands is not empty %}
                <div class="owl-carousel owl-brands-slider">
                    {% for brand in homePage.catalog.brands %}
                        <div class="slide">
                            <div class="w-brands-list-item-frame">
                                <div class="frame">
                                    <div class="w-image">
                                        {% if brand.image is not empty %}
                                            <img src="{{ asset(image_variant(brand.image, 284, 142, 'contain')) }}" alt="{{ brand.title }}" class="img block">
                                        {% endif %}
                                        <span class="brand-name">{{ brand.title }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="row justify-content-center mt-40">
                <div class="col-sm-auto col-10">
                    {% if popularBrands.buttonLabel|default('') is not empty and popularBrands.buttonUrl|default('') is not empty %}
                        <a href="{{ popularBrands.buttonUrl }}" class="button transparent blue block" style="min-width: 227px;">{{ popularBrands.buttonLabel }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
    <section class="s-line s-items-slider">
        <div class="container pt-60 pb-10">
            <div class="_h2 upper fontCor semibold color-dblue align-center xl-mb-45 md-mb-30 mb-20">
                {{ priceHits.heading|default('') }}
            </div>
            {% if homePage.catalog.hitProducts is not empty %}
                <div class="owl-carousel owl-products-more-slider">
                    {% for product in homePage.catalog.hitProducts %}
                        <div class="slide">
                            <div class="w-catalog-list-item-frame">
                                {% include 'catalog/preview.html.twig' with {product: product} only %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <div class="row justify-content-center mt-40">
                <div class="col-sm-auto col-10">
                    {% if priceHits.buttonLabel|default('') is not empty and priceHits.buttonUrl|default('') is not empty %}
                        <a href="{{ priceHits.buttonUrl }}" class="button transparent blue block">{{ priceHits.buttonLabel }}</a>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
