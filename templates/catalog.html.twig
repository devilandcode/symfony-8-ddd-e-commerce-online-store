{% extends 'layouts/main.html.twig' %}

{% block content %}
    <section class="s-line s-breadcrumbs">
        <div class="container md-pt-20 md-pb-20 pt-5">
            <div class="w-breadcrumbs-mobile-scroll-shadow">
                {% include 'general/breadcrumbs.html.twig' with {page: catalog.page} only %}
            </div>
        </div>
    </section>

    <section class="s-line">
        <div class="container pb-60">
            <h1 class="pagetitle _h3 upper fontCor semibold color-dblue">
                {{ catalog.page.h1 ?? catalog.page.title }}
            </h1>

            <div class="row mt-30">
                <aside class="col-xl-3 col-12">
                    <form method="get" class="w-catalog-aside-filters">
                        {% if catalog.categorySlug is null %}
                            <fieldset class="mb-20">
                                <legend class="_h4">Категории</legend>
                                {% for category in catalog.categories %}
                                    {% if category.parentSlug is null %}
                                        <label class="d-block mb-10">
                                            <input
                                                type="checkbox"
                                                name="categories[]"
                                                value="{{ category.id }}"
                                                {% if category.id in catalog.filters.categoryIds %}checked{% endif %}
                                            >
                                            {{ category.title }}
                                        </label>
                                    {% endif %}
                                {% endfor %}
                            </fieldset>
                        {% else %}
                            <nav class="mb-20" aria-label="Категории">
                                <div class="_h4 mb-10">Категории</div>
                                {% for category in catalog.categories %}
                                    <div class="mb-10">
                                        {% if category.parentSlug is null %}
                                            <a href="{{ path('level1', {slug: category.slug}) }}">{{ category.title }}</a>
                                        {% else %}
                                            <a href="{{ path('level2', {parentSlug: category.parentSlug, slug: category.slug}) }}">{{ category.title }}</a>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </nav>
                        {% endif %}

                        {% if catalog.brands is not empty %}
                            <fieldset class="mb-20">
                                <legend class="_h4">Бренды</legend>
                                {% for brand in catalog.brands %}
                                    <label class="d-block mb-10">
                                        <input
                                            type="checkbox"
                                            name="brands[]"
                                            value="{{ brand.id }}"
                                            {% if brand.id in catalog.filters.brandIds %}checked{% endif %}
                                        >
                                        {{ brand.title }}
                                    </label>
                                {% endfor %}
                            </fieldset>
                        {% endif %}

                        {% for characteristic in catalog.characteristics %}
                            <fieldset class="mb-20">
                                <legend class="_h4">
                                    {{ characteristic.title }}{% if characteristic.measure is not empty %} ({{ characteristic.measure }}){% endif %}
                                </legend>
                                {% for value in characteristic.values %}
                                    <label class="d-block mb-10">
                                        <input
                                            type="checkbox"
                                            name="characteristics[{{ characteristic.id }}][]"
                                            value="{{ value }}"
                                            {% if value in catalog.filters.characteristicValues[characteristic.id]|default([]) %}checked{% endif %}
                                        >
                                        {{ value }}
                                    </label>
                                {% endfor %}
                            </fieldset>
                        {% endfor %}

                        <button type="submit" class="button medium block dblue">ПОКАЗАТЬ</button>
                        <a class="d-block mt-10" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})) }}">
                            Сбросить фильтры
                        </a>
                    </form>
                </aside>

                <div class="col-xl-9 col-12">
                    <div class="row row-catalog-list _js-catalog-list-view _js-short-view xl-lg-gutters md-md-gutters sm-gutters">
                        {% for product in catalog.productPage.products %}
                            <div class="col-xl-4 col-md-4 col-xs-6 col-12 col xl-mb-30 md-mb-20 mb-10">
                                <div class="w-catalog-list-item-frame">
                                    {% include 'catalog/preview.html.twig' with {product: product} only %}
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12">
                                <p>Товары не найдены.</p>
                            </div>
                        {% endfor %}
                    </div>

                    {% if catalog.productPage.totalPages > 1 %}
                        {% set firstPage = max(1, catalog.productPage.currentPage - 2) %}
                        {% set lastPage = min(catalog.productPage.totalPages, catalog.productPage.currentPage + 2) %}
                        {% set routeParameters = app.request.attributes.get('_route_params')|default({}) %}
                        <nav class="mt-30" aria-label="Страницы каталога">
                            {% if catalog.productPage.currentPage > 1 %}
                                {% set previousParameters = app.request.query.all|merge({'page': catalog.productPage.currentPage - 1}) %}
                                <a class="mr-10" href="{{ path(app.request.attributes.get('_route'), routeParameters|merge(previousParameters)) }}">Назад</a>
                            {% endif %}

                            {% for pageNumber in firstPage..lastPage %}
                                {% set pageParameters = app.request.query.all|merge({'page': pageNumber}) %}
                                <a
                                    class="mr-10{% if pageNumber == catalog.productPage.currentPage %} _active{% endif %}"
                                    href="{{ path(app.request.attributes.get('_route'), routeParameters|merge(pageParameters)) }}"
                                    {% if pageNumber == catalog.productPage.currentPage %}aria-current="page"{% endif %}
                                >
                                    {{ pageNumber }}
                                </a>
                            {% endfor %}

                            {% if catalog.productPage.currentPage < catalog.productPage.totalPages %}
                                {% set nextParameters = app.request.query.all|merge({'page': catalog.productPage.currentPage + 1}) %}
                                <a href="{{ path(app.request.attributes.get('_route'), routeParameters|merge(nextParameters)) }}">Вперёд</a>
                            {% endif %}
                        </nav>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
