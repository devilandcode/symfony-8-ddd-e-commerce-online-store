<div class="frame">
    <div class="w-image">
        <div class="w-absolute-content top-left">
            {% if product.isNew %}
                <div class="round-sticker-default color001 mb-5">NEW</div>
            {% endif %}
            {% if product.oldPrice is not null %}
                <div class="round-sticker-default color002 mb-5">%</div>
            {% endif %}
            {% if product.isHit %}
                <div class="round-sticker-default color003 mb-5">ХИТ</div>
            {% endif %}
        </div>
        <div class="image">
            {% if product.image is not empty %}
                <img src="{{ asset(product.image) }}" alt="{{ product.title }}" class="img block">
            {% endif %}
        </div>
    </div>
    <div class="color-gray mt-5">{{ product.brandTitle }}</div>
    <div class="name _h5 semibold mt-5">
        <span class="color-black">{{ product.title }}</span>
    </div>
    <div class="w-price mt-5">
        <div class="row align-items-end sm-gutters">
            <div class="col-auto">
                <div class="price _h5 static semibold color-dblue">{{ product.price }}</div>
            </div>
            {% if product.oldPrice is not null %}
                <div class="col-auto">
                    <div class="price old color-gray line-through">{{ product.oldPrice }}</div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
